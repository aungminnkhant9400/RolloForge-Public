<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RolloForge Project Status</title>
    <style>
        :root {
            --bg-primary: #0d1117;
            --bg-secondary: #161b22;
            --bg-tertiary: #21262d;
            --text-primary: #c9d1d9;
            --text-secondary: #8b949e;
            --accent-blue: #58a6ff;
            --accent-green: #3fb950;
            --accent-yellow: #d29922;
            --accent-red: #f85149;
            --accent-purple: #a371f7;
            --border: #30363d;
        }
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            padding: 40px 0;
            border-bottom: 1px solid var(--border);
            margin-bottom: 30px;
        }
        
        h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .timestamp {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }
        
        .metric-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            transition: transform 0.2s, border-color 0.2s;
        }
        
        .metric-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent-blue);
        }
        
        .metric-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--accent-blue);
        }
        
        .metric-value.warning {
            color: var(--accent-yellow);
        }
        
        .metric-value.danger {
            color: var(--accent-red);
        }
        
        .metric-value.success {
            color: var(--accent-green);
        }
        
        .metric-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 5px;
        }
        
        .section {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 12px;
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .section-header {
            background: var(--bg-tertiary);
            padding: 15px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .section-header h2 {
            font-size: 1.2rem;
            margin: 0;
        }
        
        .section-body {
            padding: 20px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }
        
        th {
            color: var(--text-secondary);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
        
        tr:hover {
            background: var(--bg-tertiary);
        }
        
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        
        .badge-test_this_week {
            background: rgba(63, 185, 80, 0.2);
            color: var(--accent-green);
        }
        
        .badge-build_later {
            background: rgba(210, 153, 34, 0.2);
            color: var(--accent-yellow);
        }
        
        .badge-archive {
            background: rgba(139, 148, 158, 0.2);
            color: var(--text-secondary);
        }
        
        .badge-ignore {
            background: rgba(248, 81, 73, 0.2);
            color: var(--accent-red);
        }
        
        .stale-row {
            background: rgba(248, 81, 73, 0.1);
        }
        
        .stale-row:hover {
            background: rgba(248, 81, 73, 0.2);
        }
        
        .priority-high {
            color: var(--accent-green);
            font-weight: bold;
        }
        
        .priority-medium {
            color: var(--accent-yellow);
        }
        
        .priority-low {
            color: var(--text-secondary);
        }
        
        .buckets-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
        
        .bucket-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 15px;
            background: var(--bg-tertiary);
            border-radius: 8px;
        }
        
        .bucket-name {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .bucket-count {
            font-weight: bold;
            font-size: 1.1rem;
        }
        
        .github-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .github-stat {
            text-align: center;
            padding: 15px;
            background: var(--bg-tertiary);
            border-radius: 8px;
        }
        
        .github-stat-value {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--accent-purple);
        }
        
        .github-stat-label {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }
        
        .commit-list {
            list-style: none;
        }
        
        .commit-item {
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            display: flex;
            gap: 15px;
            align-items: baseline;
        }
        
        .commit-item:last-child {
            border-bottom: none;
        }
        
        .commit-sha {
            font-family: monospace;
            color: var(--accent-blue);
            font-size: 0.85rem;
        }
        
        .commit-message {
            flex: 1;
        }
        
        .commit-author {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }
        
        .action-item {
            padding: 15px;
            background: var(--bg-tertiary);
            border-radius: 8px;
            margin-bottom: 10px;
            border-left: 3px solid var(--accent-blue);
        }
        
        .action-item h4 {
            margin-bottom: 5px;
            color: var(--text-primary);
        }
        
        .action-meta {
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin-bottom: 8px;
        }
        
        .action-text {
            color: var(--accent-blue);
        }
        
        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-secondary);
        }
        
        footer {
            text-align: center;
            padding: 30px;
            color: var(--text-secondary);
            font-size: 0.85rem;
            border-top: 1px solid var(--border);
            margin-top: 30px;
        }
        
        @media (max-width: 768px) {
            .metrics-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .github-stats {
                grid-template-columns: repeat(2, 1fr);
            }
            
            th, td {
                padding: 8px;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🔥 RolloForge Project Status</h1>
            <div class="timestamp">Generated: {{ generated_at[:19] }}</div>
        </header>
        
        <!-- Metrics Overview -->
        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-value">{{ summary.total_bookmarks }}</div>
                <div class="metric-label">Total Bookmarks</div>
            </div>
            <div class="metric-card">
                <div class="metric-value {% if summary.test_this_week_count > 20 %}warning{% endif %}">{{ summary.test_this_week_count }}</div>
                <div class="metric-label">Test This Week</div>
            </div>
            <div class="metric-card">
                <div class="metric-value {% if summary.stale_count > 5 %}danger{% elif summary.stale_count > 0 %}warning{% else %}success{% endif %}">{{ summary.stale_count }}</div>
                <div class="metric-label">Stale Items</div>
            </div>
            <div class="metric-card">
                <div class="metric-value">{{ "%.1f"|format(summary.avg_priority) }}</div>
                <div class="metric-label">Avg Priority</div>
            </div>
            <div class="metric-card">
                <div class="metric-value">{{ github.open_prs }}</div>
                <div class="metric-label">Open PRs</div>
            </div>
            <div class="metric-card">
                <div class="metric-value">{{ github.recent_commits }}</div>
                <div class="metric-label">Recent Commits</div>
            </div>
        </div>
        
        <!-- Buckets Section -->
        <div class="section">
            <div class="section-header">
                <span>📁</span>
                <h2>Bucket Distribution</h2>
            </div>
            <div class="section-body">
                <div class="buckets-grid">
                    {% for bucket, count in buckets|dictsort(by='value', reverse=true) %}
                    <div class="bucket-item">
                        <div class="bucket-name">
                            {% set emoji = {'test_this_week': '⚡', 'build_later': '📚', 'archive': '📁', 'ignore': '🗑️'}.get(bucket, '📄') %}
                            <span>{{ emoji }}</span>
                            <span class="badge badge-{{ bucket }}">{{ bucket }}</span>
                        </div>
                        <div class="bucket-count">{{ count }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        
        <!-- GitHub Activity Section -->
        <div class="section">
            <div class="section-header">
                <span>🐙</span>
                <h2>GitHub Activity</h2>
            </div>
            <div class="section-body">
                {% if github.recent_commits_list %}
                <div class="github-stats">
                    <div class="github-stat">
                        <div class="github-stat-value">{{ github.open_prs }}</div>
                        <div class="github-stat-label">Open PRs</div>
                    </div>
                    <div class="github-stat">
                        <div class="github-stat-value">{{ github.recent_commits }}</div>
                        <div class="github-stat-label">Recent Commits</div>
                    </div>
                    <div class="github-stat">
                        <div class="github-stat-value">{{ github.open_issues }}</div>
                        <div class="github-stat-label">Open Issues</div>
                    </div>
                    <div class="github-stat">
                        <div class="github-stat-value">{{ github.last_push[:10] if github.last_push else 'N/A' }}</div>
                        <div class="github-stat-label">Last Push</div>
                    </div>
                </div>
                
                <h3 style="margin: 20px 0 10px; color: var(--text-secondary);">Recent Commits</h3>
                <ul class="commit-list">
                    {% for commit in github.recent_commits_list[:5] %}
                    <li class="commit-item">
                        <span class="commit-sha">{{ commit.sha }}</span>
                        <span class="commit-message">{{ commit.message[:60] }}{% if commit.message|length > 60 %}...{% endif %}</span>
                        <span class="commit-author">{{ commit.author }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <div class="empty-state">
                    <p>⚠️ GitHub data unavailable</p>
                    <p style="font-size: 0.85rem; margin-top: 10px;">Run `gh auth status` to check authentication</p>
                </div>
                {% endif %}
            </div>
        </div>
        
        <!-- Stale Items Section -->
        {% if stale_items %}
        <div class="section">
            <div class="section-header">
                <span>⚠️</span>
                <h2>Stale Items (> {{ stale_days }} days)</h2>
            </div>
            <div class="section-body">
                <table>
                    <thead>
                        <tr>
                            <th>Days Old</th>
                            <th>Priority</th>
                            <th>Bucket</th>
                            <th>Title</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in stale_items[:15] %}
                        <tr class="stale-row">
                            <td><strong>{{ item.days_old }}d</strong></td>
                            <td class="{% if item.priority_score >= 8 %}priority-high{% elif item.priority_score >= 6 %}priority-medium{% else %}priority-low{% endif %}">{{ "%.1f"|format(item.priority_score) }}</td>
                            <td><span class="badge badge-{{ item.bucket }}">{{ item.bucket }}</span></td>
                            <td>{{ item.title }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if stale_items|length > 15 %}
                <p style="margin-top: 15px; color: var(--text-secondary); text-align: center;">
                    ... and {{ stale_items|length - 15 }} more stale items
                </p>
                {% endif %}
            </div>
        </div>
        {% endif %}
        
        <!-- Priority Rankings Section -->
        <div class="section">
            <div class="section-header">
                <span>🏆</span>
                <h2>Top Priority Rankings (Worth × Priority)</h2>
            </div>
            <div class="section-body">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Combined</th>
                            <th>Priority</th>
                            <th>Worth</th>
                            <th>Effort</th>
                            <th>Bucket</th>
                            <th>Title</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in priority_rankings[:15] %}
                        <tr>
                            <td><strong>{{ loop.index }}</strong></td>
                            <td class="priority-high">{{ "%.1f"|format(item.combined_score) }}</td>
                            <td>{{ "%.1f"|format(item.priority_score) }}</td>
                            <td>{{ "%.1f"|format(item.worth_score) }}</td>
                            <td>{{ "%.1f"|format(item.effort_score) }}</td>
                            <td><span class="badge badge-{{ item.bucket }}">{{ item.bucket }}</span></td>
                            <td>{{ item.title }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Action Items Section -->
        {% if action_items %}
        <div class="section">
            <div class="section-header">
                <span>📋</span>
                <h2>Action Items</h2>
            </div>
            <div class="section-body">
                {% for item in action_items[:10] %}
                <div class="action-item">
                    <h4>{{ loop.index }}. {{ item.title }}</h4>
                    <div class="action-meta">
                        <span class="badge badge-{{ item.bucket }}">{{ item.bucket }}</span>
                        <span>Priority: {{ "%.1f"|format(item.priority_score) }}</span>
                    </div>
                    <div class="action-text">→ {{ item.next_action }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        
        <footer>
            <p>Generated by RolloForge Project Dashboard</p>
        </footer>
    </div>
</body>
</html>
