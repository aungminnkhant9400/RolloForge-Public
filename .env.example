# RolloForge — Environment Variables
# Copy this to .env and fill in your values

# Storage backend: "sqlite" or "json"
ROLLOFORGE_STORAGE_BACKEND=sqlite

# DeepSeek API (for bookmark analysis) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter API (for HTML view) — https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# X/Twitter API credentials — https://developer.x.com
X_USER_ACCESS_TOKEN=your_x_access_token_here
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here

# Telegram bot (for notifications) — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# GitHub token (for nightly builds) — https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
